`timescale 1ns / 1ps

module tb_siso;
reg s_in,clk,rst;
wire s_out;

siso uut(.s_in(s_in), .clk(clk), .rst(rst), .s_out(s_out));
   initial clk=0;
   always #5 clk =~clk;
    initial begin
    rst=1; s_in=0;
    #12;
    rst=0;
    s_in = 1; #10;  //bit 1
    s_in = 0; #10;  //bit 0
    s_in = 1; #10;  //bit 1
    s_in = 1; #10;  //bit 1
    s_in = 0; #60;   //flush remaining bits out
    $finish;
    end
endmodule
