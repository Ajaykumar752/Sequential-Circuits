`timescale 1ns / 1ps
module j_k_ff_bh_tb;
reg j,k,clk;
wire q,qbar;

j_k_ff_bh uut(.j(j), .k(k), .clk(clk), .q(q), .qbar(qbar));

initial clk=0;
always #20 clk=~clk;

initial begin
   $monitor("time=%0t j=%b k=%b clk=%b | q=%b qbar=%b",$time,j,k,clk,q,qbar);
   
        j = 0; k = 1; #30;   // reset
        j = 0; k = 0; #40;   // hold
        j = 1; k = 0; #40;   // set
        j = 0; k = 0; #40;   // hold
        j = 0; k = 1; #40;   // reset
        $finish;
      end
endmodule
